# Stock Sentinel frontend configuration (template — copy to .env.local for local dev).
#
# Both values are ORIGINS ONLY: no trailing /api or /ws path. The app appends
# /api and /ws itself. They are public (inlined into the browser bundle at build
# time), so never put secrets in NEXT_PUBLIC_* variables.
#
# Production/staging: pass these as Docker build arguments, e.g.
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://api.example.com \
#                --build-arg NEXT_PUBLIC_WS_URL=wss://api.example.com ./frontend
# A production build fails if NEXT_PUBLIC_API_URL is not set.

NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional; defaults to the API origin with http(s) -> ws(s).
NEXT_PUBLIC_WS_URL=ws://localhost:8000
